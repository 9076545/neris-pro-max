# Meta WhatsApp Cloud API: configure apenas no ambiente privado do backend.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
META_GRAPH_API_VERSION=

# E-mail autorizado do administrador; mantenha o valor real apenas no ambiente privado.
NERIS_ADMIN_EMAIL=

# Permanece desligado até validar o agente com um número de teste.
WHATSAPP_AGENT40_ENABLED=false

# Este projeto usa Cloudflare Workers AI, não OpenRouter.

# Backend FastAPI: configure somente no ambiente privado do servidor.
NERIS_MOCK_MODE=false
TURNSTILE_SECRET_KEY=
NEXUS_SUPABASE_URL=
NEXUS_SUPABASE_ANON_KEY=
NEXUS_OFFICE_API_URL=

# Persistência Neris, se habilitada no backend; use credenciais do projeto Neris.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
