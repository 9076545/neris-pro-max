{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neris-admin-api",
  "main": "worker/admin-container.js",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "routes": [
    { "pattern": "admin.nexuscentralja.com.br", "custom_domain": true }
  ],
  "containers": [
    {
      "class_name": "AdminAPI",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ADMIN_API",
        "class_name": "AdminAPI"
      }
    ]
  },
  "exports": {
    "AdminAPI": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "NERIS_ADMIN_URL": "https://admin.nexuscentralja.com.br",
    "NERIS_PUBLIC_URL": "https://neris.nexuscentralja.com.br",
    "NERIS_CHAT_URL": "https://chat.neris.nexuscentralja.com.br",
    "NERIS_MOCK_MODE": "false",
    "NERIS_ENABLE_ARTEMIS": "false",
    "WHATSAPP_AGENT40_ENABLED": "false",
    "WEG_MQTT_TLS": "true",
    "CLOUDFLARE_AI_MODEL": "@cf/meta/llama-3.1-8b-instruct",
    "CLOUDFLARE_EMBEDDING_MODEL": "@cf/baai/bge-m3"
  }
}
